{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WebappRunBulkTask",
      "Effect": "Allow",
      "Action": ["ecs:RunTask", "ecs:DescribeTasks"],
      "Resource": "*"
    },
    {
      "Sid": "WebappEcsNetworkDiscovery",
      "Effect": "Allow",
      "Action": ["ec2:DescribeSubnets", "ec2:DescribeVpcs"],
      "Resource": "*"
    },
    {
      "Sid": "WebappPassTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/webscraper-bulk-exec",
        "arn:aws:iam::ACCOUNT_ID:role/webscraper-bulk-task"
      ],
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    }
  ]
}
